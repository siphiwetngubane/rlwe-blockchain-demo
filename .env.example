# QuantumSpectra Frontend — Environment Variables
# Copy this to .env and fill in your deployed contract addresses.
# For Netlify: add these in Site Settings → Environment Variables.

# QuantumSpectra.sol deployment address
VITE_QUANTUM_SPECTRA_ADDRESS=0x0000000000000000000000000000000000000000

# Groth16Verifier.sol deployment address (used for reference; QuantumSpectra holds the ref)
VITE_GROTH16_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Chain ID:
#   1        = Ethereum Mainnet
#   11155111 = Sepolia (default)
#   8453     = Base
#   84532    = Base Sepolia
#   31337    = Hardhat / Anvil (local)
VITE_CHAIN_ID=11155111
